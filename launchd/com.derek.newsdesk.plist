<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.derek.newsdesk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/derek/code/newsdesk/scripts/run_daily.sh</string>
  </array>
  <!-- 每天 07:30 跑一次，覆盖前一天全球的事；电脑睡眠错过时，唤醒后 launchd 会补跑一次 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/derek/code/newsdesk</string>
  <key>StandardOutPath</key>
  <string>/Users/derek/code/newsdesk/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/derek/code/newsdesk/logs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
